<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Lineone - CRM Analytics Dashboard</title>

        <!-- web-logo -->
            <link rel="short icon" href="assets/images/logo/logo.svg" type="x-icon">

    
</head>

<body>
    
    <section>
        <div class="box1 box" style="margin-left: 200%;">
            <div class="content">
              <div class="image" style="border-radius: 50%; overflow: hidden; object-fit: cover;">
                <img src="<%=userImg%>" alt="Profile Image" style="max-width: 100px;min-height: 100px;">
              </div>
              <div class="level">
                <span>pro</span>
              </div>
              <div class="text">
                <p class="name"><%=fname%>  <%=lname%></p>
                <p class="job_title">Back-End Devloper</p>
                <p class="job_discription">Hi, I’m <%=fname%>, a back-end developer with a strong background in [mention any specific technologies or frameworks you use, like Node.js, Python, Java, etc.]. I specialize in building robust APIs, optimizing server performance, and managing databases.</p>
              </div>
              <div class="icons">
                <button>
                  <ion-icon name="logo-dribbble"></ion-icon>
                </button>
                <button>
                  <ion-icon name="logo-instagram"></ion-icon>
                </button>
                <button>
                  <ion-icon name="logo-twitter"></ion-icon>
                </button>
                <button>
                  <ion-icon name="logo-linkedin"></ion-icon>
                </button>
                <button>
                  <ion-icon name="logo-facebook"></ion-icon>
                </button>
                <button>
                  <ion-icon name="logo-behance"></ion-icon>
                </button>
              </div>
              <div class="button">
                <div>
                  <button class="message" type="button">Connect</button>
                </div> 
                
            &nbsp; &nbsp;
                <div>
                  <button class="connect" type="button"><a href="./login">LogOut</a></button>
                </div>
              </div>
            </div>
          </div>
    </section>
</body>
</html>
