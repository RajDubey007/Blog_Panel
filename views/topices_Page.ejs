<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Lineone - CRM Analytics Dashboard</title>

      <!-- Custom Styles -->
  <style>
    .topic{
      margin-left: 40%;
    }
    .form-card {
      min-width: 500px;
      margin: 0 auto;
      padding: 20px;
      background-color: white;
      border-radius: 10px;
      box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
    }

    .form-card h1 {
      text-align: center;
      font-size: 2rem;
      margin-bottom: 20px;
      color: #343a40;
    }

    .btn-primary {
      width: 100%;
      background-color: #3498db;
      border-color: #007bff;
      transition: background-color 0.3s ease;
    }

    .btn-primary:hover {
      background-color: #0056b3;
    }
    body{
      overflow-x: hidden;
    }
  </style>

</head>
<body>
    
    
    <section class="container">
        <div class="mb-4" style="margin-top: 40px;">
            <h2 class="titles text-center" style="margin-top: 14%;">Blog Topics</h2>
            <div class="signup-form-text">
                <form action="/addTopiceCon" method="post">
                    <div class="name rel" style="margin-right: 10px;">
                        <label for="topicSelect" class="form-label" style="font-size: 19px; font-weight: 600; margin-left: 10px;">Select Your Topic</label>
                        <input type="text"  name="topicName" placeholder="Enter the Topic" class="form-control" id="register-fname" >
                        <a href="#" class="login-icon abs text" style="margin-top: 3%;">
                            <i data-feather="edit"></i>
                        </a>
                    </div>

                    <div class="login-btn flex align-items center">
                        <button>
                            Save
                        </button>
                    </div>
                </form>
            </div>

        </div>
    </section>

</body>
</html>
