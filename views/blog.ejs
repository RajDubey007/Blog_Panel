<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Lineone - CRM Analytics Dashboard</title>
    
</head>
<body>
    

    <div class="page-body">
               
        <section>

            <ul>
                <!-- <li>
                    <a href="/">Home</a>
                </li> -->
                <li>
                    <a href="register">Register</a>
                </li>
                <li>
                    <a href="login">Login</a>
                </li>
                <li>
                    <a href="blog">Blog</a>
                </li>
                <li>
                    <a href="myblog">My Blog</a>
                </li>
                <li>
                    <a href="/add_TopicForm">Blog Topics</a>
                </li>
                <li>
                    <a href="/addSubTopicForm">Sub topics</a>
                </li>
                <li>
                    <a href="profile">Profile</a>
                </li>
                <li>
                    <a href="/changepassword">change-password</a>
                </li>
            </ul>
            
        </section>
        <section class="container">
            <div class="mb-4" style="margin-top: 40px;">
                <h2 class="titles">Latest blog</h2>
                <div class="box6">
                    <% blogData.forEach((blogs)=>{ %>
                        <div class="content">   
                            <div class="flex blog-img items-center">
                                <img src="<%=blogs.path%>" alt="blogs img" class="rounded-t-2xl object-cover max-h-120"
                                    width="700" height="320" />
                            </div>
                            <div class="blog-itam">
                                <span class="">
                                    <%=blogs.date%>
                                </span>
                                <h4 class="">
                                    <%=blogs.title%>
                                </h4>
                                <p class="">
                                    <%=blogs.description%>
                                </p>
                                
                                        <!-- Display comments for this blog -->
                                        <h5>Comments:</h5>
                                        <% if (typeof comments !== 'undefined' && comments.length > 0) { %>
                                        <% comments.forEach(comment => { %>
                                            <div class="comment-box">
                                            <p><%= comment.comment %></p>
                                            </div>
                                        <% }); %>
                                        <% } else { %>
                                        <p>No comments yet.</p>
                                        <% } %>



                                        <form class="d-flex" role="search" action="/addCommentCon" method="post">
                                           <input type="hidden" name="blogId" value="<%= blogs ? blogs._id : '' %>">

                                            <input class="form-control me-2" type="search" name="comment" placeholder="comment" aria-label="Search">
                                            <button class="btn btn-outline-primary" type="submit">
                                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-send" viewBox="0 0 16 16">
                                                    <path d="M15.854.146a.5.5 0 0 1 .11.54l-5.819 14.547a.75.75 0 0 1-1.329.124l-3.178-4.995L.643 7.184a.75.75 0 0 1 .124-1.33L15.314.037a.5.5 0 0 1 .54.11ZM6.636 10.07l2.761 4.338L14.13 2.576zm6.787-8.201L1.591 6.602l4.339 2.76z" />
                                                </svg>
                                            </button>
                                        </form>


                            </div>

                        </div>

                        <% }) %>
                </div>

            </div>

        </section>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
    
   
    <script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.11/index.global.min.js"></script>

    <script>
        feather.replace();
    </script>

</body>
</html>
